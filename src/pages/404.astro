---
import Base from "../layouts/Base.astro";
---

<Base
  title="Seite nicht gefunden | rausgucken.de"
  description="Diese Seite gibt es nicht (mehr)." noindex={true}
>
  <section class="nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>Hier ist nichts los.</h1>
    <p class="nf-lead">Diese Seite gibt es nicht (mehr). Heute lohnt sich ein Blick woanders hin.</p>
    <div class="nf-actions">
      <a class="nf-btn nf-btn--primary" href="/ludwigsburg/heute/">Heute in Ludwigsburg</a>
      <a class="nf-btn" href="/">Stadt suchen</a>
    </div>
  </section>
</Base>

<style>
  .nf { max-width: 720px; margin: 0 auto; padding: 3rem 1rem 4rem; }
  .nf-code {
    font-family: var(--font-heading); font-weight: 700; font-size: clamp(4rem, 18vw, 8rem);
    line-height: 1; margin: 0 0 0.5rem; color: var(--papaya);
  }
  .nf h1 { font-family: var(--font-heading); font-size: clamp(1.6rem, 5vw, 2.2rem); margin: 0 0 0.75rem; color: var(--text); }
  .nf-lead { color: var(--text-60); font-size: 1.05rem; margin: 0 0 1.75rem; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .nf-btn {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.25rem;
    border: 1.5px solid var(--border); border-radius: 0; background: var(--surface-card);
    color: var(--text); font-weight: 600; text-decoration: none;
  }
  .nf-btn--primary { background: var(--papaya-fill); color: var(--ink); border-color: var(--ink); }
  .nf-btn:hover { box-shadow: var(--shadow-hover); transform: translate(-2px, -2px); transition: transform 120ms; }
  @media (prefers-reduced-motion: reduce) { .nf-btn:hover { transform: none; } }
</style>
