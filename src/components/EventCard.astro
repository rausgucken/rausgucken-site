---
// src/components/EventCard.astro: retro row (v4). Styles: src/styles/event-row.css (global).
// CONTRACT (do not rename): classes event-card, card-link, date-badge, card-body, card-tags, card-title,
// card-meta, card-desc, merken-btn/.merken-icon/.merken-label, source-attribution, freshness-stamp;
// data-attrs tags/source/age-min/age-max/date/weekdays/location. Client twin: src/scripts/event-card-render.js
import tagGroups from '../data/tag-groups.json';
import '../styles/event-row.css';

const { event: ev } = Astro.props;
const city = ev.city || "ludwigsburg";

function formatDate(iso) {
  if (!iso) return null;
  const d = new Date(iso + "T12:00:00");
  return {
    day:     d.getDate(),
    month:   d.toLocaleDateString("de-DE", { month: "short" }),
    weekday: d.toLocaleDateString("de-DE", { weekday: "short" }),
    full:    d.toLocaleDateString("de-DE", { day: "numeric", month: "long", year: "numeric" }),
  };
}
const TAG_LABELS = { Fuehrung: "Führung" };
const GROUP_OF = {};
for (const g of Object.values(tagGroups.groups)) for (const t of g.tags) GROUP_OF[t] = g.chip;

const tagsArr     = Array.isArray(ev.tags) ? ev.tags : [];
const chips       = tagsArr.slice(0, 3).map(t => ({ label: TAG_LABELS[t] || t, cls: GROUP_OF[t] || "outline" }));
const dateObj     = formatDate(ev.date_start);
const isStanding  = !ev.date_start;
const isSponsored = ev.sponsored === true;
const showNew     = ev.is_new && !isSponsored;
const showAge     = ev.age_min != null;
const ageText     = showAge ? ("ab " + ev.age_min + " J." + (ev.age_max ? "–" + ev.age_max : "+")) : "";
const weekdayAttr = ev.weekdays ? ev.weekdays.join(",") : "";
const endDay = (ev.date_start && ev.date_end && ev.date_end !== ev.date_start && ev.date_end.slice(0, 7) === ev.date_start.slice(0, 7))
  ? new Date(ev.date_end + "T12:00:00").getDate() : null;
const dayText     = dateObj ? (endDay ? dateObj.day + ".–" + endDay + "." : String(dateObj.day)) : "";
const hasTagRow   = isSponsored || showNew || ev.is_booked_out || chips.length > 0 || showAge;
const priceShort  = ev.price ? String(ev.price).split(" ").slice(0, 3).join(" ") : null;
const locShort    = ev.location ? ev.location.replace("Residenzschloss Ludwigsburg", "Residenzschloss LB") : null;
---

<article
  class:list={[
    "event-card",
    { "event-card--standing":  isStanding },
    { "event-card--new":       ev.is_new },
    { "event-card--sponsored": isSponsored },
  ]}
  data-tags={tagsArr.join(",")}
  data-source={ev.source}
  data-age-min={ev.age_min ?? ""}
  data-age-max={ev.age_max ?? ""}
  data-date={ev.date_start ?? ""}
  data-weekdays={weekdayAttr}
  data-location={ev.location ?? ""}
>
  <a
    href={`/${city}/events/${ev.slug}`}
    class="card-link"
    aria-label={`${ev.title}${dateObj ? `, ${dateObj.full}` : ""}${ev.location ? ` – ${ev.location}` : ""}`}
  >
    {dateObj ? (
      <div class="date-badge" aria-hidden="true">
        <span class="date-weekday">{dateObj.weekday}</span>
        <span class:list={["date-day", { "date-day--range": !!endDay }]}>{dayText}</span>
        <span class="date-month">{dateObj.month}</span>
      </div>
    ) : (
      <div class="date-badge date-badge--standing" aria-hidden="true">
        <span class="date-infinity">∞</span>
        <span class="date-month">immer</span>
      </div>
    )}

    <div class="card-body">
      <h3 class="card-title">{ev.title}</h3>

      <div class="card-meta">
        {ev.time && (
          <span class="meta-item">
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {ev.time}
          </span>
        )}
        {isStanding && !ev.time && (
          <span class="meta-item">
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Regelmäßig
          </span>
        )}
        {locShort && (
          <span class="meta-item">
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {locShort}
          </span>
        )}
        {priceShort && (
          <span class="meta-item">
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
            {priceShort}
          </span>
        )}
      </div>

      {ev.description && (
        <p class="card-desc">
          {ev.description.length > 110 ? ev.description.slice(0, 110) + "…" : ev.description}
        </p>
      )}

      {hasTagRow && (
        <div class="card-tags">
          {isSponsored && <span class="badge-sponsored" aria-label="Anzeige">Anzeige</span>}
          {showNew && <span class="badge-new">Neu</span>}
          {ev.is_booked_out && <span class="badge-booked">Ausgebucht</span>}
          {chips.map(c => <span class={`tag tag--${c.cls}`}>{c.label}</span>)}
          {showAge && <span class="tag tag--age">{ageText}</span>}
        </div>
      )}
    </div>
  </a>

  <div class="card-footer">
    <div class="footer-line1">
      <button
        class="merken-btn"
        data-slug={ev.slug}
        aria-label={`Veranstaltung merken: ${ev.title}`}
        aria-pressed="false"
        title="Merken"
        onclick="event.stopPropagation()"
      >
        <svg class="merken-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
        </svg>
        <span class="merken-label">Merken</span>
      </button>
      {ev.source_label && (
        <a
          href={ev.original_url}
          target="_blank"
          rel="noopener noreferrer"
          class="source-attribution"
          onclick="event.stopPropagation()"
        >
          Quelle: {ev.source_label}<span class="source-more">&nbsp;— Originalseite prüfen</span>
        </a>
      )}
    </div>
  </div>
</article>

<script is:inline>
  // Merken: save/unsave events in localStorage
  // Key: 'rg-saved' → JSON array of {slug, title, date_start, city, url}
  // Runs for each EventCard on page load to restore saved state.
  (function() {
    function getSaved() {
      try { return JSON.parse(localStorage.getItem('rg-saved') || '[]'); } catch { return []; }
    }
    function setSaved(arr) {
      try { localStorage.setItem('rg-saved', JSON.stringify(arr)); } catch {}
    }

    // Restore button state — debounced global so only last card's IIFE triggers it
    // Each EventCard runs this IIFE; debounce ensures one restore pass after all cards render
    if (!window._rgRestoreScheduled) {
      window._rgRestoreScheduled = true;
      window._rgRestoreMerken = function() {
        const saved = JSON.parse(localStorage.getItem('rg-saved') || '[]');
        document.querySelectorAll('.merken-btn').forEach(btn => {
          const isSaved = saved.some(e => e.slug === btn.dataset.slug);
          btn.setAttribute('aria-pressed', String(isSaved));
          btn.querySelector('.merken-label').textContent = isSaved ? 'Gemerkt' : 'Merken';
        });
      };
      window.addEventListener('rg:saved-changed', window._rgRestoreMerken);
    }
    // Schedule restore — each card resets the timer; fires 50ms after last card
    clearTimeout(window._rgRestoreTimer);
    window._rgRestoreTimer = setTimeout(window._rgRestoreMerken, 50);

    // Bind click listeners once after all cards render — guarded to prevent
    // duplicate bindings from is:inline running once per EventCard instance.
    if (!window._rgClicksBound) {

      const _origRestore = window._rgRestoreMerken;
      window._rgRestoreMerken = function() {
        _origRestore && _origRestore();
        if (!window._rgClicksBound) {
          window._rgClicksBound = true;
          document.querySelectorAll('.merken-btn').forEach(btn => {
            btn.addEventListener('click', function() {
        const slug = this.dataset.slug;
        const card = this.closest('.event-card');
        // Gather event data from card's data attributes + nearby DOM
        const title = card.querySelector('.card-title')?.textContent?.trim() || '';
        const date  = card.dataset.date || null;
        const city  = card.querySelector('.card-link')?.href?.split('/')[3] || '';
        const url   = card.querySelector('.card-link')?.href || '';

        let saved = getSaved();
        const idx = saved.findIndex(e => e.slug === slug);
        const nowSaved = idx === -1;

        if (nowSaved) {
          saved.push({ slug, title, date_start: date, city, url, _src: 'local' });

          // Notify native Capacitor code to subscribe to FCM hardware topic
          if (window.Capacitor) {
            window.dispatchEvent(new CustomEvent('fcm:subscribe', { detail: { topic: `event_${slug}` } }));
          } else {
            console.log(`Web simulation: Subscribed to topic event_${slug}`);
          }
        } else {
          saved.splice(idx, 1);

          // Notify native Capacitor code to unsubscribe from FCM hardware topic
          if (window.Capacitor) {
            window.dispatchEvent(new CustomEvent('fcm:unsubscribe', { detail: { topic: `event_${slug}` } }));
          } else {
            console.log(`Web simulation: Unsubscribed from topic event_${slug}`);
          }
        }
        setSaved(saved);

        this.setAttribute('aria-pressed', String(nowSaved));
        this.querySelector('.merken-label').textContent = nowSaved ? 'Gemerkt' : 'Merken';

        // Dispatch event so /meine-events/ page can react without reload
        window.dispatchEvent(new CustomEvent('rg:saved-changed', { detail: { slug, saved: nowSaved } }));
        // Sync slug list to push backend (no-op if push not enabled)
        if (localStorage.getItem('rg-push-enabled') === '1') {
          const uuid = localStorage.getItem('rg-uuid');
          if (uuid) {
            const slugs = JSON.parse(localStorage.getItem('rg-saved') || '[]').map(e => e.slug).filter(Boolean);
            fetch('https://push.rausgucken.de/update-saved', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ uuid, saved_slugs: slugs })
            }).catch(() => {});
          }
        }
            });
          });
        }
      };
    }
  })();
</script>

<script>
  import '../scripts/event-card-render.js';
</script>
